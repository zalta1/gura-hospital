# Local development — never commit real secrets or PHI.
# TODO(HIPAA): secret manager, rotate JWT keys, disable demo-login in production.

SECRET_KEY=INSECURE-LOCAL-DEV-KEY-CHANGE-ME
DATABASE_URL=sqlite:///./gura.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=local

# Optional field-level PHI key (32+ chars). Leave empty for plaintext local MVP.
ENCRYPTION_KEY=

# Optional LLM. If empty, the mock keyword agent is used.
OPENAI_API_KEY=

VITE_API_URL=http://127.0.0.1:8000

# Local Supabase — after `npx supabase start`, copy keys from its output if they differ.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo staff logins only. Bookings always use submit_booking on the Supabase URL above.
# VITE_PORTAL_LOCAL_DEMO=true

# Voice navigator — fill these from the ElevenLabs Conversational AI dashboard.
# Create an agent at https://elevenlabs.io/app/conversational-ai
# Register these as Client Tools (not Server Tools) on the agent: book_appointment,
# check_availability, flag_emergency, match_doctor, record_intake_fields, check_insurance.
# See src/lib/voice/client-tools.ts for parameter schemas. GET /api/elevenlabs/signed-url
# reads these env vars. After changing turn/TTS/prompt locally, run:
# node scripts/sync-voice-agent.mjs
# Disable the built-in end_call system tool — intake must finish before submit.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Twilio SMS / Voice medication reminders (server-only — never put these in VITE_*).
# Doctor portal: channel=SMS or Cold call + Approve to send → POST /api/twilio/*.
# POC always uses TWILIO_TEST_TO. Trial Voice: verified number in your signup country.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: Voice trial From can differ from SMS — copy from Console → Voice → Try out Voice.
TWILIO_VOICE_FROM_NUMBER=
TWILIO_TEST_TO=
TWILIO_SMS_BODY=sms_appointment_reminders
TWILIO_VOICE_SAY_TEXT=
# Gmail SMTP notifications (server-only). Use a 16-character Google App Password
# from an account with 2-Step Verification — not the account's regular password.
# https://myaccount.google.com/apppasswords — never put these in VITE_*.
# Without these, /api/notifications/send-gmail returns status:"mocked" (local demo).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
